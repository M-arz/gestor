# Copia a infra/.env y cambia los valores. Solo para desarrollo local.
POSTGRES_PASSWORD=dev_postgres_pw
AUTH_DB_PASSWORD=dev_auth_pw
TEAMS_DB_PASSWORD=dev_teams_pw
MATCHES_DB_PASSWORD=dev_matches_pw
DISCIPLINE_DB_PASSWORD=dev_discipline_pw
NOTIFICATIONS_DB_PASSWORD=dev_notifications_pw
# Secretos de sesión. En producción deben ser aleatorios y largos (openssl rand -base64 48).
JWT_SECRET=dev-only-jwt-secret-cambiar-0123456789abcdef
IP_HASH_SECRET=dev-only-ip-hash-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Cifrado del documento de identidad (teams-service). En producción: claves propias y nunca cambiarlas sin migrar.
#   DOCUMENTO_CLAVE: 32 bytes en base64  ->  openssl rand -base64 32
#   DOCUMENTO_HASH_CLAVE: texto largo y aleatorio  ->  openssl rand -base64 48
DOCUMENTO_CLAVE=ZGV2LW9ubHktZG9jdW1lbnRvLWtleS0zMi1ieXRlcyE=
DOCUMENTO_HASH_CLAVE=dev-only-documento-hash-clave-0123456789
